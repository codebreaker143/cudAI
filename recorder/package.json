{
  "name": "cudai-recorder",
  "productName": "cudAI",
  "version": "1.0.0",
  "description": "cudAI desktop recorder for computer-use data",
  "main": ".webpack/main",
  "scripts": {
    "prestart": "node -e \"if(process.platform !== 'win32') { require('child_process').exec('lsof -ti:5328 | xargs -I {} kill -9 {} >/dev/null 2>&1 || true', (err) => { if(err) console.log('Port cleanup skipped:', err.message); }); }\"",
    "start": "cross-env FLASK_DEBUG=1 electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "backend": "python api/backend.py",
    "build-flask": "cd api && python -m build",
    "test": "cd api && python -m pytest tests && cd .. && tsc --noEmit -p ."
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.4.0",
    "@electron-forge/maker-deb": "^7.4.0",
    "@electron-forge/maker-dmg": "^7.4.0",
    "@electron-forge/maker-rpm": "^7.4.0",
    "@electron-forge/maker-squirrel": "^7.4.0",
    "@electron-forge/maker-zip": "^7.4.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.4.0",
    "@electron-forge/plugin-fuses": "^7.4.0",
    "@electron-forge/plugin-webpack": "^7.4.0",
    "@electron/fuses": "^1.8.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "@vercel/webpack-asset-relocator-loader": "1.7.3",
    "autoprefixer": "^10.4.19",
    "cross-env": "^7.0.3",
    "css-loader": "^6.0.0",
    "electron": "31.2.1",
    "eslint": "^8.0.1",
    "eslint-plugin-import": "^2.25.0",
    "fork-ts-checker-webpack-plugin": "^7.2.13",
    "node-loader": "^2.0.0",
    "postcss": "^8.4.39",
    "postcss-loader": "^8.1.1",
    "style-loader": "^3.0.0",
    "tailwindcss": "^3.4.6",
    "ts-loader": "^9.2.2",
    "ts-node": "^10.0.0",
    "typescript": "~5.6.3"
  },
  "keywords": [],
  "author": {
    "name": "Sahul",
    "email": "sahuliit@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "@electron/osx-sign": "^1.3.1",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@headlessui/react": "^2.1.2",
    "@heroicons/react": "^2.1.5",
    "@mui/icons-material": "^5.16.7",
    "@mui/material": "^5.16.7",
    "@tailwindcss/forms": "^0.5.7",
    "axios": "^1.7.3",
    "electron-log": "^5.1.7",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^18.3.1",
    "react-router-dom": "^6.24.1",
    "socket.io-client": "^4.7.5"
  }
}
